# Traffic Guardian AI - environment variables
# Copy this file to .env and fill in your own values.
# .env itself is gitignored - never commit your real API key.

# 'synthetic' generates placeholder data end-to-end; 'real' expects
# files already in data/raw/ (see README.md).
TGA_DATA_MODE=synthetic

# Host/port the API binds to when started via run.bat
HOST=127.0.0.1
PORT=8000

# --- Real-data layer (route + clearance) ---
# OSRM (real road routing) and Open-Meteo (real weather) need NO key.
# TomTom (real live congestion) needs a free key from developer.tomtom.com
# Leave blank to run on the physics-based fallback (still labeled honestly
# in every API response as "fallback_estimate", never silently faked).
TOMTOM_API_KEY=your_tomtom_key_here
